<UserControl x:Class="iPhoneSystemCleaner.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="🔍  Quét Dữ liệu hệ thống"
                       Style="{StaticResource SectionTitle}"
                       FontSize="22"/>
            <TextBlock Text="Tool sẽ kết nối SSH và tính dung lượng từng nhóm file có thể xóa"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Scan controls -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <StackPanel>
                <!-- Total disk info -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TỔNG DUNG LƯỢNG" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="TbDiskTotal" Text="—"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ĐÃ SỬ DỤNG" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="TbDiskUsed" Text="—"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DỰ KIẾN GIẢI PHÓNG" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="TbEstimatedFree" Text="Chưa quét"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- Progress area -->
                <ProgressBar x:Name="ScanProgressBar"
                             Style="{StaticResource GlowProgressBar}"
                             Minimum="0" Maximum="100" Value="0"
                             Height="8" Margin="0,0,0,8"/>
                <TextBlock x:Name="TbScanStatus"
                           Text="Sẵn sàng để quét"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,16"/>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnStartScan"
                            Style="{StaticResource AccentButton}"
                            Height="44"
                            Click="BtnStartScan_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BtnScanIcon" Text="🔍  " FontSize="15"/>
                            <TextBlock x:Name="BtnScanText" Text="Bắt đầu quét" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCancelScan"
                            Style="{StaticResource GhostButton}"
                            Height="44" Margin="12,0,0,0"
                            Content="⏹  Dừng"
                            IsEnabled="False"
                            Click="BtnCancelScan_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Scan log terminal -->
        <Border Grid.Row="2"
                Background="#111111"
                BorderBrush="#252526"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Terminal top bar -->
                <Border Grid.Row="0"
                        Background="#1A1A1A"
                        Padding="14,8"
                        BorderBrush="#252526"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <!-- Mac-style dots -->
                        <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0"/>
                        <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0"/>
                        <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,12,0"/>
                        <TextBlock Text="SSH Terminal — iPhone System Scan"
                                   Foreground="#556070"
                                   FontSize="11" FontFamily="Consolas"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Log output -->
                <ScrollViewer x:Name="LogScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="14,10">
                    <TextBlock x:Name="TbLog"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#00E5A0"
                               TextWrapping="Wrap"
                               Text="root@iPhone:~$ _"
                               LineHeight="22"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
