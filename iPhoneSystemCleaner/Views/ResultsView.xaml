<UserControl x:Class="iPhoneSystemCleaner.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,8,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🗂️  Kết quả quét — Chọn mục cần xóa"
                           Style="{StaticResource SectionTitle}"
                           FontSize="20"/>
                <TextBlock x:Name="TbResultSubtitle"
                           Text="Chưa có dữ liệu quét"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <!-- Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Sắp xếp: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbSort" Width="140" Height="36" Margin="0,0,16,0" SelectedIndex="0" SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="Dung lượng"/>
                    <ComboBoxItem Content="Mức độ rủi ro"/>
                    <ComboBoxItem Content="Tên (A-Z)"/>
                </ComboBox>
                <Button Style="{StaticResource GhostButton}"
                        Content="☑ Chọn tất cả"
                        Height="36" Margin="0,0,8,0"
                        Click="BtnSelectAll_Click"/>
                <Button Style="{StaticResource GhostButton}"
                        Content="☐ Bỏ chọn tất"
                        Height="36"
                        Click="BtnSelectNone_Click"/>
            </StackPanel>
        </Grid>

        <!-- Summary bar -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,16"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ĐÃ CHỌN" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TbSelectedCount" Text="0 mục"
                               Foreground="{StaticResource AccentBlueBrush}"
                               FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="SẼ GIẢI PHÓNG" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TbSelectedSize" Text="0 B"
                               Foreground="{StaticResource SuccessBrush}"
                               FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TỔNG TÌM THẤY" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TbTotalFound" Text="0 B"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="AN TOÀN / CẦN CẨN THẬN" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TbSafetyCount" Text="— / —"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Categories list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CategoriesPanel" Margin="0,0,0,8"/>
        </ScrollViewer>

        <!-- Bottom action bar -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Delete log -->
                <Border Grid.Column="0"
                        x:Name="DeleteLogPanel"
                        Background="#111111"
                        BorderBrush="#252526"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,16,0"
                        Padding="12,8"
                        Visibility="Collapsed"
                        MaxHeight="100">
                    <ScrollViewer x:Name="DeleteLogScroll" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TbDeleteLog"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#00E5A0"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <!-- Delete button area -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <CheckBox x:Name="ChckEnableBackup"
                              Content="📦 Sao lưu vào máy tính trước khi xóa"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              IsChecked="True"
                              Margin="0,0,0,12"
                              HorizontalAlignment="Right"
                              Checked="ChckEnableBackup_CheckedChanged"
                              Unchecked="ChckEnableBackup_CheckedChanged"/>

                    <Button x:Name="BtnDelete"
                            Style="{StaticResource DangerButton}"
                            Height="50" MinWidth="180"
                            IsEnabled="False"
                            Click="BtnDelete_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BtnDeleteIcon" Text="🗑️  " FontSize="16"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BtnDeleteText" Text="Xóa đã chọn"
                                           FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="BtnDeleteSubtext" Text="0 mục · 0 B"
                                           FontSize="11" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Progress bar for deletion -->
                    <ProgressBar x:Name="DeleteProgressBar"
                                 Style="{StaticResource GlowProgressBar}"
                                 Minimum="0" Maximum="100" Value="0"
                                 Height="4" Margin="0,6,0,0"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
