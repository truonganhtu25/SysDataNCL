<Window x:Class="iPhoneSystemCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:iPhoneSystemCleaner.Views"
        Title="iPhone System Data Cleaner"
        Width="980" Height="680"
        MinWidth="860" MinHeight="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False" 
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Tab button style -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="icon" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A2E"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Tab style -->
        <Style x:Key="TabBtnActive" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#333333"/>
        </Style>
    </Window.Resources>

    <!-- Main border with rounded corners and shadow -->
    <Border CornerRadius="12" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>
        <Grid Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>     <!-- TitleBar -->
                <RowDefinition Height="60"/>     <!-- Tab nav -->
                <RowDefinition Height="*"/>      <!-- Content -->
                <RowDefinition Height="28"/>     <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ═══ CUSTOM TITLEBAR ═══ -->
            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarGradient}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App title with logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="16,0">
                        <!-- Glow dot -->
                        <Ellipse Width="8" Height="8" Margin="0,0,10,0">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#00D4FF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#7C3AED" BlurRadius="8" ShadowDepth="0" Opacity="1"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="iPhone System Data Cleaner"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbVersion" Text="  v1.0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,8,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}"
                                Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                ToolTip="Thu nhỏ"
                                Click="BtnMinimize_Click"/>
                        <Button x:Name="BtnMaxRestore"
                                Style="{StaticResource TitleBarButton}"
                                Content="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                ToolTip="Phóng to"
                                Click="BtnMaxRestore_Click"/>
                        <Button Style="{StaticResource CloseButton}"
                                Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                ToolTip="Đóng"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ TAB NAVIGATION ═══ -->
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Device info -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="24,0,0,0">
                        <Button x:Name="BtnTabConnect"
                                Style="{StaticResource TabBtnActive}"
                                Tag="🔌" Content="Kết nối"
                                Click="BtnTabConnect_Click"/>

                        <Button x:Name="BtnTabScan"
                                Style="{StaticResource TabBtn}"
                                Tag="🔍" Content="Quét hệ thống"
                                IsEnabled="False"
                                Click="BtnTabScan_Click"/>

                        <Button x:Name="BtnTabResults"
                                Style="{StaticResource TabBtn}"
                                Tag="📁" Content="Kết quả &amp; Xóa"
                                IsEnabled="False"
                                Click="BtnTabResults_Click"/>
                        
                        <Button x:Name="BtnTabRestore"
                                Style="{StaticResource TabBtn}"
                                Tag="♻️" Content="Khôi phục"
                                Click="BtnTabRestore_Click"/>
                    </StackPanel>

                    <!-- Device info chip -->
                    <Border x:Name="DeviceInfoPanel" Grid.Column="1"
                            Background="#252526"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="12,6"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DeviceStatusDot" Width="8" Height="8"
                                     Fill="{StaticResource SuccessBrush}"
                                     Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#22C55E" BlurRadius="6" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="TbDeviceName"
                                       Text="iPhone"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TbDeviceIos"
                                       Text=" · iOS --"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ CONTENT AREA ═══ -->
            <Grid Grid.Row="2">
                <views:ConnectView x:Name="ViewConnect"/>
                <views:ScanView x:Name="ViewScan" Visibility="Collapsed"/>
                <views:ResultsView x:Name="ViewResults" Visibility="Collapsed"/>
                <views:RestoreView x:Name="ViewRestore" Visibility="Collapsed"/>
            </Grid>

            <!-- ═══ STATUS BAR ═══ -->
            <Border Grid.Row="3"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TbStatus"
                               Grid.Column="0"
                               Text="Sẵn sàng — Nhập thông tin kết nối để bắt đầu"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="iPhone System Data Cleaner • Hỗ trợ: Rootless Jailbreak"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Resize grip -->
            <ResizeGrip Grid.Row="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Visibility="Visible"
                        Opacity="0.3"/>
        </Grid>
    </Border>
</Window>
